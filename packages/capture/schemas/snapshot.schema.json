{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smelt-oss.local/schemas/snapshot.schema.json",
  "title": "Smelt frozen DOM snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "viewport", "rootFrameId", "rootElementId", "frames", "elements"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "metadata": {"$ref": "#/$defs/metadata"},
    "viewport": {"$ref": "#/$defs/viewport"},
    "rootFrameId": {"type": "string", "pattern": "^f[0-9]+$"},
    "rootElementId": {"type": "string", "pattern": "^e[0-9]+$"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/snapshotElement"}
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureId", "capturedAt", "url", "backend", "browserName", "browserVersion", "userAgent", "egressLocation", "storageState", "navigationTiming", "captureTiming", "observationMs"],
      "properties": {
        "captureId": {"type": "string", "minLength": 1},
        "capturedAt": {"type": "string", "format": "date-time"},
        "url": {"type": "string"},
        "backend": {"type": "string", "enum": ["steel", "local"]},
        "browserName": {"type": ["string", "null"]},
        "browserVersion": {"type": ["string", "null"]},
        "userAgent": {"type": ["string", "null"]},
        "egressLocation": {"type": ["string", "null"]},
        "storageState": {"type": ["object", "null"]},
        "navigationTiming": {"type": ["object", "null"]},
        "captureTiming": {"type": ["object", "null"]},
        "observationMs": {"type": "number", "minimum": 0}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "deviceScaleFactor"],
      "properties": {
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0},
        "deviceScaleFactor": {"type": "number", "minimum": 0}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title", "parentFrameId", "parentElementId", "accessible"],
      "properties": {
        "id": {"type": "string", "pattern": "^f[0-9]+$"},
        "url": {"type": "string"},
        "title": {"type": "string"},
        "parentFrameId": {"type": ["string", "null"]},
        "parentElementId": {"type": ["string", "null"]},
        "accessible": {"type": "boolean"}
      }
    },
    "snapshotElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frameId", "parentId", "childIndex", "tagName", "namespaceURI", "attributes", "textSample", "children"],
      "properties": {
        "id": {"type": "string", "pattern": "^e[0-9]+$"},
        "frameId": {"type": "string", "pattern": "^f[0-9]+$"},
        "parentId": {"type": ["string", "null"]},
        "childIndex": {"type": "integer", "minimum": 0},
        "tagName": {"type": "string", "minLength": 1},
        "namespaceURI": {"type": ["string", "null"]},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
        "textSample": {"type": "string"},
        "children": {"type": "array", "items": {"type": "string", "pattern": "^e[0-9]+$"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smelt-oss.local/schemas/features.schema.json",
  "title": "Smelt frozen feature file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "viewport", "elements"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "metadata": {"$ref": "snapshot.schema.json#/$defs/metadata"},
    "viewport": {"$ref": "snapshot.schema.json#/$defs/viewport"},
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/featureElement"}
    }
  },
  "$defs": {
    "featureElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frameId", "layout", "intrinsic"],
      "properties": {
        "id": {"type": "string", "pattern": "^e[0-9]+$"},
        "frameId": {"type": "string", "pattern": "^f[0-9]+$"},
        "layout": {"$ref": "#/$defs/layout"},
        "intrinsic": {"$ref": "#/$defs/intrinsic"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rect", "zIndex", "position", "isFixed", "isSticky", "display", "visibility", "opacity"],
      "properties": {
        "rect": {"$ref": "#/$defs/rect"},
        "zIndex": {"type": ["integer", "null"]},
        "position": {"type": "string"},
        "isFixed": {"type": "boolean"},
        "isSticky": {"type": "boolean"},
        "display": {"type": "string"},
        "visibility": {"type": "string"},
        "opacity": {"type": "number"}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "top", "right", "bottom", "left", "width", "height"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "top": {"type": "number"},
        "right": {"type": "number"},
        "bottom": {"type": "number"},
        "left": {"type": "number"},
        "width": {"type": "number"},
        "height": {"type": "number"}
      }
    },
    "intrinsic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagName", "role", "attributeNames", "classTokens", "textSample", "textLength", "descendantTextLength", "wordCount", "descendantElementCount", "linkDensity", "hasDialogRole", "hasAriaModal", "hasClickableControl"],
      "properties": {
        "tagName": {"type": "string", "minLength": 1},
        "role": {"type": ["string", "null"]},
        "attributeNames": {"type": "array", "items": {"type": "string"}},
        "classTokens": {"type": "array", "items": {"type": "string"}},
        "textSample": {"type": "string"},
        "textLength": {"type": "integer", "minimum": 0},
        "descendantTextLength": {"type": "integer", "minimum": 0},
        "wordCount": {"type": "integer", "minimum": 0},
        "descendantElementCount": {"type": "integer", "minimum": 0},
        "linkDensity": {"type": "number", "minimum": 0},
        "hasDialogRole": {"type": "boolean"},
        "hasAriaModal": {"type": "boolean"},
        "hasClickableControl": {"type": "boolean"}
      }
    }
  }
}

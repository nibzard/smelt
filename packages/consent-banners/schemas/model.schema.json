{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smelt model artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "abi",
    "modelVersion",
    "task",
    "trainedAt",
    "corpus",
    "rulesHash",
    "featureNames",
    "calibration",
    "forest"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "abi": {"type": "string", "const": "smelt-model-v1"},
    "modelVersion": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "trainedAt": {"type": "string", "format": "date-time"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "rulesHash": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
    "featureNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 254,
      "items": {"type": "string", "minLength": 1}
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "threshold", "score"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "threshold": {"type": "number"},
        "score": {"type": "string", "enum": ["probability"]}
      }
    },
    "forest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "byteOrder",
        "alignmentBytes",
        "nodeLayout",
        "leafFeatureIndex",
        "packed"
      ],
      "properties": {
        "encoding": {"type": "string", "const": "base64"},
        "byteOrder": {"type": "string", "const": "little-endian"},
        "alignmentBytes": {"type": "integer", "const": 4},
        "nodeLayout": {
          "type": "array",
          "prefixItems": [
            {"type": "string", "const": "featureIndex:u8"},
            {"type": "string", "const": "threshold:f16"},
            {"type": "string", "const": "left:u16"},
            {"type": "string", "const": "right:u16"},
            {"type": "string", "const": "leafValue:f32"}
          ],
          "items": false
        },
        "leafFeatureIndex": {"type": "integer", "const": 255},
        "packed": {"type": "string", "minLength": 1}
      }
    }
  }
}

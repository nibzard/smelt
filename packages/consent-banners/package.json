{
  "name": "@smelt-oss/consent-banners",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Consent-banner detection, pre-trained. The wedge product (IDEA.md 2.5): detect only, no clicking. Contents when built: dist/model.smelt.json, dist/rules.js, MODEL.md, one-call detect wrapper.",
  "sideEffects": false,
  "exports": {
    ".": "./index.mjs",
    "./bench": "./bench.mjs",
    "./steel-workflow": "./steel-workflow.mjs",
    "./rules": "./rules.mjs",
    "./model": "./model.mjs",
    "./model.smelt.json": "./model.smelt.json",
    "./train": "./train.mjs",
    "./teacher": "./teacher.mjs",
    "./loop": "./loop.mjs"
  },
  "bin": {
    "smelt-consent-bench": "./bench-cli.mjs",
    "smelt-consent-loop": "./loop-cli.mjs"
  },
  "files": [
    "README.md",
    "index.mjs",
    "model.smelt.json",
    "model.mjs",
    "bench.mjs",
    "bench-cli.mjs",
    "steel-workflow.mjs",
    "rules.mjs",
    "schemas/model.schema.json",
    "train.mjs",
    "train-cli.mjs",
    "teacher.mjs",
    "loop.mjs",
    "loop-cli.mjs"
  ],
  "scripts": {
    "bench": "node bench-cli.mjs",
    "size": "node scripts/size.mjs",
    "test": "node --test",
    "train": "node train-cli.mjs",
    "loop": "node loop-cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@smelt-oss/runtime": "0.0.0",
    "linkedom": "^0.18.4"
  },
  "devDependencies": {
    "@smelt-oss/capture": "0.0.0",
    "@smelt-oss/pilot": "0.0.0"
  }
}
